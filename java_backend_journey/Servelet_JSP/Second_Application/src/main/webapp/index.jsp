<!DOCTYPE html>
<html>
<head>
    <title>User Registration</title>
</head>

<body>

<h2>Kindly Register to proceed further!</h2>

<form method="post" action="registration">

    <table>

        <tr>
            <td>User Name</td>
            <td>
                <input type="text" name="uname">
            </td>
        </tr>

        <tr>
            <td>User City</td>
            <td>
                <input type="text" name="ucity">
            </td>
        </tr>

        <tr>
            <td>
                <input type="submit" value="Sign Up">
            </td>
        </tr>

    </table>

</form>

</body>
</html>